pipeline {
    agent none

    stages {

        stage('Ubuntu Check') {
            agent {
                label 'ubuntu-agent'
            }

            steps {
                sh '''
                java -version
                mvn -version
                '''
            }
       }
        stage('Fedora Check') {
            agent {
                label 'fedora-agent'
            }

            steps {
                sh '''
                java -version
                '''
            }
        }

        stage('Maven Build') {
    agent {
        label 'ubuntu-agent'
    }

    steps {
        sh '''
            cd maven-projekat
            mvn clean install
        '''

        stash includes: 'maven-projekat/target/*.jar', name: 'jar-file'
    }
}

stage('Ansible Deploy') {
    agent any

    steps {

        unstash 'jar-file'

        sh '''
            cd ansible
            ansible-playbook -i inventory playbook.yml
        '''
    }
}

stage('Deployment Report Generation (General Info)'){
  agent any
  steps{
        sh '''
        if [ ! -f deployment_report.csv ]; then
            echo "build,number,date,status" > deployment_report.csv
        fi

        echo "${BUILD_NUMBER},$(date '+%Y-%m-%d %H:%M:%S'),SUCCESS" >> deployment_report.csv

        cat deployment_report.csv
    '''
    archiveArtifacts artifacts: 'deployment_report.csv'
    
}

}

stage('Monitoring Links'){
  agent any
  steps{
      echo '''
      Grafana :  http://192.168.100.148:3000
      Promeheus : http://192.168.100.148:9090
      Alertmanager : http://192.168.100.148:9093  
         '''



}
 
}

    }
}
